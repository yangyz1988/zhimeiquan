# ========================================
# 智媒圈 生产环境配置
# ========================================

# ============ 应用 ============
NEXT_PUBLIC_APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com
FRONTEND_URL=https://www.zhimeiquan.com
LOG_FORMAT=json
LOG_LEVEL=info
# Uvicorn 工作进程数（默认 4）
# UVICORN_WORKERS=4

# ============ 数据目录 ============
# 数据持久化根路径（Docker 中默认 /app/data/）
# ZHIMEIQUAN_DATA_DIR=/app/data

# ============ API 密钥（前后端共享）============
# 生成方法: openssl rand -hex 32
API_SECRET=your-random-secret-here

# ============ DeepSeek LLM ============
DEEPSEEK_API_KEY=sk-your-deepseek-key

# DeepSeek API Base URL（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 多模型（可选）============
QWEN_API_KEY=sk-your-qwen-key
ERNIE_API_KEY=your-ernie-key
ERNIE_SECRET_KEY=your-ernie-secret
HUNYUAN_API_KEY=your-hunyuan-key

# ============ 图像生成（可选）============
OPENAI_API_KEY=sk-your-openai-key
STABILITY_API_KEY=sk-your-stability-key

# ============ SiliconFlow（数字人视频 + 图像生成）============
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ============ 数据库 ============
# 开发：file:./dev.db
# 生产：postgresql://user:pass@host:5432/zhimeiquan
DATABASE_URL=postgresql://zhimeiquan:password@postgres:5432/zhimeiquan

# PostgreSQL 连接信息（用于 Docker Compose 变量注入）
POSTGRES_USER=zhimeiquan
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=zhimeiquan

# PostgreSQL 备份（每天凌晨 3 点）
BACKUP_RETENTION_DAYS=30

# ============ Redis 缓存 + 限流 ============
REDIS_URL=redis://redis:6379

# 限流配置（每分钟请求数/用户）
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW=60

# ============ Clerk 认证 ============
# https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk JWT 鉴权（后端验证用，生产强烈建议配置 PEM 公钥）
# 方式一：PEM 公钥（推荐，性能好，不依赖外部请求）
CLERK_JWT_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PUBLIC KEY-----
# 方式二：JWKS URL（备用，自动从 Clerk 获取公钥）
# CLERK_JWKS_URL=https://your-domain.accounts.clerk.dev/.well-known/jwks.json
# JWT Issuer 验证
CLERK_JWT_ISSUER=https://your-domain.accounts.clerk.dev
# JWT Audience（可选）
# CLERK_JWT_AUDIENCE=

# ============ Stripe 支付 ============
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# 可选: Edge TTS 语音配置 (video.py 用)
# ZH_VOICE_MALE=zh-CN-YunxiNeural
# ZH_VOICE_FEMALE=zh-CN-XiaoxiaoNeural

# 可选: 内容知识库路径 (content_loader.py 用)
# ZHIMEIQUAN_CONTENT_DIR=../content

# 可选: 数据目录根路径（默认 ../data/，Docker 中为 /app/data/）
# ZHIMEIQUAN_DATA_DIR=/app/data
