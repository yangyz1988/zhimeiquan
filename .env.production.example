# ========================================
# 智媒圈 生产环境配置
# ========================================

# ============ 应用 ============
NEXT_PUBLIC_APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com
LOG_FORMAT=json
LOG_LEVEL=info

# ============ DeepSeek LLM ============
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ============ 多模型（可选）============
QWEN_API_KEY=sk-your-qwen-key
ERNIE_API_KEY=your-ernie-key
ERNIE_SECRET_KEY=your-ernie-secret
HUNYUAN_API_KEY=your-hunyuan-key

# ============ 图像生成（可选）============
OPENAI_API_KEY=sk-your-openai-key
STABILITY_API_KEY=sk-your-stability-key
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ============ 数据库 ============
# 开发：file:./dev.db
# 生产：postgresql://user:pass@host:5432/zhimeiquan
DATABASE_URL=postgresql://zhimeiquan:password@postgres:5432/zhimeiquan

# ============ Redis 缓存 + 限流 ============
REDIS_URL=redis://redis:6379

# ============ Clerk 认证 ============
# https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============ Stripe 支付 ============
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
