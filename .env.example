# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API Base URL（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database (SQLite 默认；生产建议 PostgreSQL)
DATABASE_URL=file:./dev.db

# Redis
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# 后端 API 密钥（前端和后端需一致，留空则不校验）
# 生成方法: openssl rand -hex 32
API_SECRET=

# Clerk 认证 (从 https://dashboard.clerk.com/ 获取)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk JWT 鉴权（后端验证用，二选一即可）
# 方式一：PEM 公钥（生产推荐，性能好）- 从 Clerk Dashboard → JWT Templates 获取
# CLERK_JWT_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# 方式二：JWKS URL（开发方便，自动获取）- 通常为 https://<your-clerk-domain>/.well-known/jwks.json
# CLERK_JWKS_URL=https://your-clerk-domain.accounts.clerk.dev/.well-known/jwks.json
# JWT Issuer（可选，增强验证）
# CLERK_JWT_ISSUER=https://your-clerk-domain.accounts.clerk.dev
# JWT Audience（可选）
# CLERK_JWT_AUDIENCE=

# 多模型 LLM API 密钥（仅 DeepSeek 为必须）
# QWEN_API_KEY=sk-your-qwen-key
# ERNIE_API_KEY=your-ernie-key
# ERNIE_SECRET_KEY=your-ernie-secret
# HUNYUAN_API_KEY=your-hunyuan-key

# 图像生成 API 密钥（可选）
# OPENAI_API_KEY=sk-your-openai-key
# STABILITY_API_KEY=sk-your-stability-key

# SiliconFlow API 密钥（数字人视频 + 图像生成）
# SILICONFLOW_API_KEY=sk-your-siliconflow-key

# 可选: 日志配置（默认 json / INFO）
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# 可选: Edge TTS 语音配置 (video.py 用)
# ZH_VOICE_MALE=zh-CN-YunxiNeural
# ZH_VOICE_FEMALE=zh-CN-XiaoxiaoNeural

# 可选: 内容知识库路径 (content_loader.py 用)
# ZHIMEIQUAN_CONTENT_DIR=../content

# 可选: 数据目录根路径（默认 ../data/，Docker 中为 /app/data/）
# ZHIMEIQUAN_DATA_DIR=../data

# ===== 浏览器采集配置（Playwright）=====
# 是否启用浏览器采集（生产建议 true，开发可设 false）
# BROWSER_SCRAPE_ENABLED=true

# 浏览器模式（headless=true 后台运行，生产推荐；false 可视化调试）
# BROWSER_HEADLESS=true

# 最大并发页面数（建议 2-4，根据服务器配置调整）
# BROWSER_MAX_CONTEXTS=3

# 规则变化通知 Webhook URL（可选，空则不通知）
# RULE_CHANGE_WEBHOOK_URL=https://hooks.slack.com/xxx

# 竞品爬取单次最大内容数
# COMPETITOR_CRAWL_MAX_ITEMS=20

# ==================== 生产环境专用 ====================

# PostgreSQL 连接信息（仅 Docker Compose 生产环境使用）
# POSTGRES_USER=zhimeiquan
# POSTGRES_PASSWORD=your-strong-password-here
# POSTGRES_DB=zhimeiquan

# Stripe 支付 (从 https://dashboard.stripe.com/apikeys 获取)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
