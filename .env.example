# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here

# Database (SQLite 默认；生产建议 PostgreSQL)
DATABASE_URL=file:./dev.db

# Redis
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Clerk 认证 (从 https://dashboard.clerk.com/ 获取)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 可选: Edge TTS 语音配置 (video.py 用)
# ZH_VOICE_MALE=zh-CN-YunxiNeural
# ZH_VOICE_FEMALE=zh-CN-XiaoxiaoNeural

# 可选: 内容知识库路径 (content_loader.py 用)
# ZHIMEIQUAN_CONTENT_DIR=../content
